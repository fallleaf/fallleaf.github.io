/* 通用分页布局 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;          /* 关键：允许换行 */
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  box-sizing: border-box;
}

.pagination .page-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.4rem;
  height: 2.4rem;
  padding: 0 0.8rem;
  font-size: 1.05rem; /* 这里调大字号，例如 1rem 或 1.05rem */
  box-sizing: border-box;
}

/* 小屏专门优化（iPhone 等） */
@media (max-width: 480px) {
  .pagination {
    padding-inline: 0.5rem;
    justify-content: flex-start; /* 左对齐更节省空间 */
  }

  .pagination .page-link {
    min-width: 2.4rem;
    height: 2.4rem;
    padding: 0 0.7rem;
    font-size: 1.05rem;
  }
}

/* 时间线样式 */
.timeline-container {
    max-width: 600px;
    margin: 40px auto;
    padding: 0 20px;
    position: relative;
    background: transparent;
    list-style: none;
}

.timeline-container::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: var(--timeline-line, #e6e6e6);
    transform: translateX(-50%);
    transition: background 0.3s;
}

.timeline-item {
    display: flex;
    margin-bottom: 40px;
    position: relative;
}

.timeline-marker {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-color, #4285f4), var(--primary-color-dark, #1a237e));
    border: 3px solid var(--timeline-bg, #fff);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    box-shadow: 0 0 0 4px var(--timeline-shadow, #e3f2fd);
    transition: background 0.3s, box-shadow 0.3s;
}

.timeline-content {
    width: calc(50% - 40px);
    padding: 0px 10px 12px 15px;
    border-radius: 10px;
    background: var(--timeline-bg, #fff);
    box-shadow: 0 3px 16px rgba(0, 0, 0, 0.10);
    color: var(--timeline-text, #263238);
    transition: background 0.3s, color 0.3s, box-shadow 0.3s;
    margin-top: 0;
}

.timeline-item:nth-child(odd) .timeline-content {
    margin-left: auto;
}

.timeline-item:nth-child(even) .timeline-content {
    margin-right: auto;
}

.timeline-date {
    color: var(--primary-color, #4285f4);
    margin-bottom: 10px;
    font-weight: bold;
}

.timeline-text {
    line-height: 1.6;
}

/* 响应式设计 - 时间线在小屏幕上改为单列布局 */
@media (max-width: 768px) {
    .timeline-container {
        max-width: 100%;
    }

    .timeline-container::before {
        left: 20px;
    }

    .timeline-item {
        flex-direction: column;
    }

    .timeline-marker {
        left: 20px;
    }

    .timeline-content {
        width: calc(100% - 45px);
        margin-left: 45px !important;
    }
}

/* 时间线深色模式 */
[data-scheme="dark"] {
    --timeline-bg: #23272e;
    --timeline-line: #31343a;
    --timeline-text: #e6e6e6;
    --timeline-shadow: #181a20;
    --primary-color: #64b5f6;
    --primary-color-dark: #1976d2;
}

[data-scheme="dark"] .timeline-content {
    background: linear-gradient(135deg, #23272e 80%, #262a32 100%);
    color: var(--timeline-text, #e6e6e6);
    box-shadow: 0 3px 16px rgba(0, 0, 0, 0.40);
    border: 1px solid #31343a;
}

[data-scheme="dark"] .timeline-marker {
    background: linear-gradient(135deg, #64b5f6, #1976d2);
    border: 3px solid #23272e;
    box-shadow: 0 0 0 4px #181a20;
}

[data-scheme="dark"] .timeline-date {
    color: #90caf9;
}
/* 评论卡片 */
[data-scheme="dark"] .wl-card {
/*  background-color: var(--card-background);*/
   background-color: #e6e6e6;
   color: #424242;
}

/* 评论正文 */
[data-scheme="dark"] .wl-content {
  color: #424242;
}

/* 回复、元信息（时间、@） */
[data-scheme="dark"] .wl-meta,
[data-scheme="dark"] .wl-time,
[data-scheme="dark"] .wl-nick {
  color: #b8b8b8;
}
/* Light 模式 */
[data-scheme="light"] .article-lastmod,
[data-scheme="light"] .waline-pageview-count {
    color: #333;   /* 深色，避免纯黑 */
}

/* Dark 模式 */
[data-scheme="dark"] .article-lastmod,
[data-scheme="dark"] .waline-pageview-count {
    color: #e6e6e6; /* 浅灰，比纯白更柔和 */
}

/* ============================================================
   fallleaf 正文阅读优化 —— 仅作用于 .article-page .main-article .article-content
   不动首页、侧栏、列表页、Widget、主题结构
   ============================================================ */

// 1) 正文容器：桌面端限宽 780px，标题/元信息略宽 820px
.article-page {
    .main-article {
        // 文章整体卡片去圆角/阴影可选，这里保持主题原样，只控制内容宽度
        
        .article-header {
            .article-details {
                max-width: 820px;
                margin-left: auto;
                margin-right: auto;
            }
        }

        .article-content {
            max-width: 780px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 0;
            padding-right: 0;
            
            // 2) 字体栈：系统无衬线，中文优先
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Noto Sans CJK SC",
                "Microsoft YaHei",
                "PingFang SC",
                sans-serif;
            
            // 3) 字号与行高
            font-size: 1.7rem;      // 17px (html=62.5%)
            line-height: 1.9;
            
            // 4) 段落间距：1.15em，比默认 1.5em 更紧凑但有呼吸感
            > p {
                margin: 1.15em 0;
            }

            // 5) 正文颜色：#333 on #fafafa（由 body 背景控制，这里只设字色）
            color: #333;

            // 6) H1：clamp 响应式，不加装饰线
            h1 {
                font-size: clamp(2.8rem, 3vw, 3.6rem);  // 28~36px
                line-height: 1.3;
                font-weight: 700;
                margin-top: 0.6em;
                margin-bottom: 0.4em;
                
                // 移除主题自带的左侧 accent border 与负 margin
                margin-inline-start: 0;
                padding-inline-start: 0;
                border-inline-start: none;
                
                a.header-anchor { display: none; }
            }

            // 7) H2：章节感，上下留白更平衡
            h2 {
                font-size: 2.4rem;  // 24px
                line-height: 1.4;
                font-weight: 600;
                margin-top: 1.8em;
                margin-bottom: 0.7em;
                
                margin-inline-start: 0;
                padding-inline-start: 0;
                border-inline-start: none;
                
                a.header-anchor { display: none; }
            }

            // 8) H3：明显小于 H2，留白平衡
            h3 {
                font-size: 2.0rem;  // 20px
                line-height: 1.5;
                font-weight: 600;
                margin-top: 1.5em;
                margin-bottom: 0.6em;
                
                margin-inline-start: 0;
                padding-inline-start: 0;
                border-inline-start: none;
                
                a.header-anchor { display: none; }
            }

            // H4-H6 保持层级递减
            h4 { font-size: 1.8rem; line-height: 1.5; margin-top: 1.6em; margin-bottom: 0.5em; }
            h5 { font-size: 1.7rem; line-height: 1.5; margin-top: 1.5em; margin-bottom: 0.5em; }
            h6 { font-size: 1.6rem; line-height: 1.5; margin-top: 1.4em; margin-bottom: 0.5em; }

            // 9) 引用块：极简左竖线，无背景卡片
            blockquote {
                margin: 1.5em 0;
                border-inline-start: 3px solid #ccc;
                padding-inline-start: 1em;
                color: #666;
                font-style: italic;
                background: none;
                
                // 移除主题的负 margin 扩展
                margin-left: 0;
                margin-right: 0;
                width: auto;
            }

            // 10) 图片：普通图片跟随正文 780px，复杂架构图可通过 .wide 类突破
            img {
                max-width: 100%;
                height: auto;
                border-radius: 4px;
            }

            figure {
                margin: 1.5em 0;
                margin-left: 0;
                margin-right: 0;
                width: auto;
                text-align: center;
            }

            figcaption {
                font-size: 1.4rem;
                color: #999;
                margin-top: 0.5em;
            }

            // 允许通过 class="wide" 让复杂架构图突破到 1000px
            figure.wide,
            .wide {
                max-width: 1000px;
                margin-left: calc(50% - 500px);
                margin-right: calc(50% - 500px);
                width: 1000px;
                
                @media (max-width: 1040px) {
                    max-width: 100%;
                    margin-left: 0;
                    margin-right: 0;
                    width: auto;
                }
            }

            // 11) 代码块：14px，允许横向滚动，不强制换行
            pre {
                font-size: 1.4rem;  // 14px
                line-height: 1.6;
                overflow-x: auto;
                padding: 1.5rem;
                border-radius: 6px;
            }

            code {
                font-size: 0.9em;
                font-family: var(--code-font-family);
            }

            .highlight {
                padding: 0;
                
                pre {
                    margin: 0;
                    padding: 1.5rem;
                }
            }

            // 12) 表格
            .table-wrapper {
                margin-left: 0;
                margin-right: 0;
                width: auto;
                padding: 0;
            }

            table {
                font-size: 1.4rem;
            }

            // 13) HR
            hr {
                width: 100%;
                max-width: 780px;
                margin: 2.5em auto;
                border: none;
                border-top: 1px solid #e0e0e0;
            }

            // 14) 移除主题对 blockquote/figure/highlight/pre/gallery/video/table 的负 margin 扩展
            blockquote,
            figure,
            .highlight,
            pre,
            .gallery,
            .video-wrapper,
            .table-wrapper,
            .s_video_simple {
                margin-left: 0;
                margin-right: 0;
                width: auto;
            }
        }

        .article-footer {
            max-width: 780px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 0;
            padding-right: 0;
        }
    }
}

// 15) 手机端：更克制的留白与字号
@media (max-width: 768px) {
    .article-page {
        .main-article {
            .article-header {
                .article-details {
                    max-width: 100%;
                    padding-left: 1.8rem;
                    padding-right: 1.8rem;
                }
            }

            .article-content {
                max-width: 100%;
                padding-left: 1.8rem;
                padding-right: 1.8rem;
                font-size: 1.7rem;   // 17px
                line-height: 1.9;

                > p {
                    margin: 1em 0;
                }

                h1 { font-size: 2.9rem; }  // 29px
                h2 { font-size: 2.3rem; margin-top: 2em; margin-bottom: 0.7em; }  // 23px
                h3 { font-size: 1.9rem; margin-top: 1.6em; margin-bottom: 0.5em; }  // 19px
                h4 { font-size: 1.7rem; }
                h5 { font-size: 1.6rem; }
                h6 { font-size: 1.5rem; }

                pre { font-size: 1.3rem; padding: 1rem; }

                figure.wide,
                .wide {
                    max-width: 100%;
                    margin-left: 0;
                    margin-right: 0;
                    width: auto;
                }
            }

            .article-footer {
                max-width: 100%;
                padding-left: 1.8rem;
                padding-right: 1.8rem;
            }
        }
    }
}

// 16) 深色模式适配：正文 #e6e6e6 on #1a1a1a（近似）
[data-scheme="dark"] {
    .article-page {
        .main-article {
            .article-content {
                color: #e6e6e6;

                blockquote {
                    border-inline-start-color: #555;
                    color: #aaa;
                }

                hr {
                    border-top-color: #444;
                }

                figcaption {
                    color: #888;
                }

                code {
                    color: #d0d0d0;
                }
            }
        }
    }
}

// 17) 可选：如果想让 body 背景变 #fafafa（浅色模式），取消下面注释
